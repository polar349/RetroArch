
name: Build RetroArch 1.22.2 Android ARM64

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-22.04
    timeout-minutes: 90

    steps:
      - name: Checkout official source
        uses: actions/checkout@v4
        with:
          repository: libretro/RetroArch
          ref: v1.22.2
          path: RetroArch

      - name: Set up Java 11
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '11'

      - name: Set up Android SDK
        uses: android-actions/setup-android@v3

      - name: Install Android components
        run: |
          yes | sdkmanager --licenses
          sdkmanager "platforms;android-30" "build-tools;30.0.3" "ndk;22.0.7026061"

      - name: Compile APK
        working-directory: RetroArch/pkg/android/phoenix
        run: |
          chmod +x gradlew
          ./gradlew --no-daemon assembleAarch64Debug

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: RetroArch-1.22.2-ARM64
          if-no-files-found: error
          path: RetroArch/pkg/android/phoenix/build/outputs/apk/aarch64/debug/*.apk
